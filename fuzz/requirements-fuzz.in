# atheris 3.0.0 ships no CPython 3.14 wheel, so the wheel-only central
# coverage-evidence image (a newer interpreter, currently CPython 3.14) can only
# install 3.1.0. This repo's fuzz job runs on CPython 3.12, where 3.1.0 also has a
# wheel, so 3.1.0 satisfies both (cp312 fuzz + cp314 coverage-evidence).
# Compile: uv pip compile fuzz/requirements-fuzz.in --generate-hashes --python-version 3.12 --universal -o fuzz/requirements-fuzz.txt
atheris==3.1.0
